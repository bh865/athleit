{
  "name": "athleit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@athleit/web",
    "dev:mobile": "turbo run dev --filter=@athleit/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "bash scripts/db-types.sh",
    "db:test": "bash scripts/db-test-remote.sh",
    "db:test:remote": "bash scripts/db-test-remote.sh",
    "db:push:remote": "supabase db push --remote",
    "db:types:remote": "bash scripts/db-types.sh --remote",
    "db:push": "supabase db push --remote",
    "db:push:dry": "supabase db push --remote --dry-run"
  },
  "devDependencies": {
    "@athleit/config": "workspace:*",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "turbo": "^2.11.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
