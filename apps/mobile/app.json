{
  "expo": {
    "name": "Athleit",
    "slug": "athleit",
    "scheme": "athleit",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.athleit.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.athleit.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
