{
  "expo": {
    "name": "Athleit",
    "slug": "athleit",
    "scheme": "athleit",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.athleit.app",
      "supportsTablet": true,
      "associatedDomains": ["applinks:athleit.app"]
    },
    "android": {
      "package": "com.athleit.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "athleit.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "athleit.app",
              "pathPrefix": "/claim"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Athleit uses your photos so you can add a picture of your child."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages"
        }
      ]
    ]
  }
}
