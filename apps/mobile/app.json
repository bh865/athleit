{
  "expo": {
    "name": "Athleit",
    "slug": "athleit",
    "scheme": "athleit",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.athleit.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:athleit.app"
      ]
    },
    "android": {
      "package": "com.athleit.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "athleit.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "athleit.app",
              "pathPrefix": "/claim"
            },
            {
              "scheme": "https",
              "host": "athleit.app",
              "pathPrefix": "/r"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.athleit.app",
          "enableGooglePay": true
        }
      ],
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Athleit uses your photos so you can add a picture of your child."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9e0b2b23-8897-41ca-9360-adc943ee3446"
      }
    },
    "owner": "bhayes865"
  }
}
