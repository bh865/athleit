# Copy to .env.local (git-ignored) and fill in. Never commit real secrets.
# Expo inlines EXPO_PUBLIC_* values into the app bundle, so only put public values here.
#
# After `pnpm db:start`, run `pnpm supabase status`:
#   API URL         -> EXPO_PUBLIC_SUPABASE_URL
#   Publishable key -> EXPO_PUBLIC_SUPABASE_ANON_KEY (sb_publishable_...; legacy anon JWT also works)
#
# "127.0.0.1" only works in the iOS Simulator. On a physical phone use your computer's LAN IP
# (http://192.168.x.x:54321); on the Android emulator use http://10.0.2.2:54321.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public web origin used in shared invite links and QR codes (and for universal links).
EXPO_PUBLIC_WEB_ORIGIN=https://athleit.app
# Stripe (TEST mode only in Phase 4): the PUBLISHABLE key, never a secret key. Needs a development build (EAS), not Expo Go.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Address search (Google Places) needs NO key here: GOOGLE_PLACES_API_KEY is a Supabase Edge Function secret only. See docs/scheduling.md.
