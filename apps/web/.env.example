# Copy to .env.local (git-ignored) and fill in. Never commit real secrets.
#
# Both values come from the local Supabase stack. After `pnpm db:start`, run
# `pnpm supabase status` and copy:
#   API URL            -> NEXT_PUBLIC_SUPABASE_URL      (http://127.0.0.1:54321)
#   Publishable key    -> NEXT_PUBLIC_SUPABASE_ANON_KEY (starts with sb_publishable_...;
#                         the legacy "anon key" JWT works here too)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web push (optional): the PUBLIC VAPID key (never the private key). See docs/notifications.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Stripe (TEST mode only in Phase 4): the PUBLISHABLE key, never a secret key. Secret keys live in Supabase Edge Function secrets.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile PUBLIC site key (secret lives in Edge Function secrets). Test key always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Address search (Google Places) needs NO key here: GOOGLE_PLACES_API_KEY is a Supabase Edge Function secret only. See docs/scheduling.md.

# Apple Developer Team ID (10 characters), server only. Serves /.well-known/apple-app-site-association so
# invite, claim and registration links open the iOS app. Unset means the file answers 404.
APPLE_TEAM_ID=
# Android app-signing certificate SHA-256 fingerprint(s), comma separated, server only. Serves
# /.well-known/assetlinks.json for the autoVerify intent filters. Unset means 404.
ANDROID_CERT_SHA256=

# Social sign-in buttons. Set to "true" only for a provider that is enabled with real credentials in the
# Supabase project (README: "Google and Apple sign-in"). Unset means the button is not shown.
NEXT_PUBLIC_AUTH_GOOGLE=
NEXT_PUBLIC_AUTH_APPLE=
# Optional. When set, "Terms" and "Privacy Policy" in the consent line (and the account page) link here.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Optional. The public site origin (for example https://app.athleit.com), used for the help sitemap and robots.txt.
NEXT_PUBLIC_APP_URL=
