# Copy to .env.local (git-ignored) and fill in. Never commit real secrets.
#
# Both values come from the local Supabase stack. After `pnpm db:start`, run
# `pnpm supabase status` and copy:
#   API URL            -> NEXT_PUBLIC_SUPABASE_URL      (http://127.0.0.1:54321)
#   Publishable key    -> NEXT_PUBLIC_SUPABASE_ANON_KEY (starts with sb_publishable_...;
#                         the legacy "anon key" JWT works here too)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web push (optional): the PUBLIC VAPID key (never the private key). See docs/notifications.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
